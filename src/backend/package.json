{
  "name": "yuanly-backend",
  "version": "1.1.0",
  "description": "Yuanly AI Backend — Travel platform for Chinese tourists in Turkey",
  "main": "dist/src/index.js",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node dist/src/index.js",
    "start:prod": "prisma migrate deploy && node dist/src/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node prisma/seed.ts",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "test": "ts-node scripts/smoke-test.ts"
  },
  "keywords": ["yuanly", "travel", "turkey", "china", "ai"],
  "author": "Yuanly Team",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^12.0.2",
    "morgan": "^1.10.0",
    "prisma": "^5.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
