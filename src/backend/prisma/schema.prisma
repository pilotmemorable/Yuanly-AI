generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// JSON-ish fields (images, tags, contactInfo, ...) are stored as JSON strings and
// parsed by the controllers. Enumerations are plain strings validated in code:
//   User.role:            USER | MERCHANT | ADMIN
//   Booking.status:       PENDING | CONFIRMED | REJECTED | CANCELLED | COMPLETED | NO_SHOW
//   Booking.source:       APP | MANUAL
//   Slot.status:          AVAILABLE | CLOSED

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String?
  phone             String?
  fullName          String?
  avatar            String?
  membershipLevel   String            @default("SILVER")
  preferredLanguage String            @default("CN")
  trustScore        Float             @default(0.0)
  travelStyle       String?
  role              String            @default("USER")
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  bookings          Booking[]
  reviews           Review[]
  posts             SocialPost[]
  interactions      UserInteraction[]
  notifications     Notification[]
  merchant          Merchant?

  @@index([role])
}

model Merchant {
  id             String       @id @default(uuid())
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessName   String
  category       String
  location       String
  latitude       Float?
  longitude      Float?
  description    String?
  images         String       @default("[]")
  rating         Float        @default(0.0)
  reviewCount    Int          @default(0)
  isVerified     Boolean      @default(false)
  isActive       Boolean      @default(true)
  commissionRate Float        @default(0.1)
  contactInfo    String       @default("{}")
  operatingHours String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  experiences    Experience[]
  slots          Slot[]
}

model Experience {
  id            String    @id @default(uuid())
  merchantId    String
  merchant      Merchant  @relation(fields: [merchantId], references: [id])
  title         String
  titleCn       String?
  titleTr       String?
  description   String
  descriptionCn String?
  descriptionTr String?
  priceCny      Float
  priceUsd      Float?
  duration      String
  capacity      Int       @default(1)
  images        String    @default("[]")
  tags          String    @default("[]")
  rating        Float     @default(0.0)
  reviewCount   Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  slots         Slot[]
  reviews       Review[]

  @@index([merchantId])
}

model Slot {
  id           String     @id @default(uuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  merchantId   String
  merchant     Merchant   @relation(fields: [merchantId], references: [id])
  startTime    DateTime
  endTime      DateTime
  status       String     @default("AVAILABLE")
  capacity     Int        @default(1)
  bookedCount  Int        @default(0)
  priceCny     Float
  createdAt    DateTime   @default(now())
  bookings     Booking[]

  @@unique([experienceId, startTime])
  @@index([startTime])
}

model Booking {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id])
  slotId       String?
  slot         Slot?      @relation(fields: [slotId], references: [id])
  bookingDate  DateTime   @default(now())
  slotTime     DateTime
  guestCount   Int        @default(1)
  guestName    String?
  guestPhone   String?
  source       String     @default("APP")
  status       String     @default("PENDING")
  totalAmount  Float
  currency     String     @default("CNY")
  paymentRef   String?
  qrCode       String?
  notes        String?
  cancelReason String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  payment      Payment?
  review       Review?

  @@index([userId])
  @@index([experienceId])
  @@index([status])
  @@index([slotTime])
}

// Reserved for a future online-payment integration (not used in the beta).
model Payment {
  id              String   @id @default(uuid())
  bookingId       String   @unique
  booking         Booking  @relation(fields: [bookingId], references: [id])
  method          String
  amount          Float
  currency        String   @default("CNY")
  status          String   @default("INITIATED")
  transactionId   String?
  paymentUrl      String?
  idempotencyKey  String   @unique
  webhookReceived Boolean  @default(false)
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id           String     @id @default(uuid())
  bookingId    String     @unique
  booking      Booking    @relation(fields: [bookingId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id])
  rating       Int
  comment      String
  mediaUrls    String     @default("[]")
  isVerified   Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@index([experienceId])
}

model SocialPost {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceId String?
  title        String
  content      String
  mediaUrls    String   @default("[]")
  likes        Int      @default(0)
  shares       Int      @default(0)
  tags         String   @default("[]")
  createdAt    DateTime @default(now())
}

model UserInteraction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  targetId  String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AdminLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  targetId  String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
