# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=5050
DATABASE_URL=postgresql://user:password@localhost:5432/yuanly
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# The single administrator account (admin panel). Password is only used on first boot
# (or when ADMIN_FORCE_PASSWORD_RESET=true).
ADMIN_EMAIL=pilotmemorable@gmail.com
ADMIN_PASSWORD=
ADMIN_FORCE_PASSWORD_RESET=false
# Browser origins allowed to call the API (native apps need nothing). Comma separated.
CORS_ORIGIN=
# Seed the demo catalogue (3 companies, 4 experiences, 30 days of slots)
SEED_DEMO=false
# Optional tester accounts for App Review / internal testing
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_MERCHANT_EMAIL=
DEMO_MERCHANT_PASSWORD=
